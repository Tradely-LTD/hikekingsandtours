# ─── Local development ────────────────────────────────────────────────────────
# Backend API origin. Must match where hikekingsbackend is listening (PORT=3000).
# Swap to the Railway deployment to develop against the live API:
#   VITE_API_BASE_URL=https://hikekingsbackend-production.up.railway.app
VITE_API_BASE_URL=http://localhost:3000

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Project Settings -> API. The anon/publishable key is public by design.
# NEVER put the service_role key in a VITE_ variable - it would ship to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Paystack PUBLIC key only (pk_test_... / pk_live_...). Never the secret key.
VITE_PAYSTACK_PUBLIC_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to true to browse the store without a live backend.
VITE_STORE_DEMO_MODE=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
